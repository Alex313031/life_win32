group("game_of_life") {
  public_deps = [
    ":gol",
  ]
}

group("gol") {
  public_deps = [
    ":gol_win32",
  ]
}

executable("gol_win32") {
  configs += [
    ":gol_config",
  ]
  sources = [
    "src/gol_win32.cc",
    "src/resource.rc",
  ]
}

config("gol_config") {
  include_dirs = [
    "./src",
  ]
  # Track unused functions
  cflags = [ "-Wunused-function" ]
  libs = [
    "kernel32",
    "user32",
    "shell32",
    "comctl32",
    "comdlg32",
    "gdi32",
    "winmm",
  ]
}
